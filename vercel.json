{
  "rewrites": [
    { "source": "/quiniela", "destination": "/quiniela/index.html" },
    { "source": "/quiniela/admin", "destination": "/quiniela/admin.html" }
  ],
  "headers": [
    {
      "source": "/assets/:file*.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/assets/:file*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
